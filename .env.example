# MARkit - Environment Configuration

# Option A: Comma-separated list of multiple Gemini API keys for random rotation per request
GEMINI_API_KEYS=AIzaSyA_example_key_1,AIzaSyB_example_key_2,AIzaSyC_example_key_3

# Option B: Individual numbered keys (also automatically detected and pooled into rotation)
# GEMINI_API_KEY_1=AIzaSyA_example_key_1
# GEMINI_API_KEY_2=AIzaSyB_example_key_2
# GEMINI_API_KEY_3=AIzaSyC_example_key_3

# Option C: Single key fallback
# GEMINI_API_KEY=AIzaSyA_example_key_1

# Server port (default 8000)
PORT=8000
